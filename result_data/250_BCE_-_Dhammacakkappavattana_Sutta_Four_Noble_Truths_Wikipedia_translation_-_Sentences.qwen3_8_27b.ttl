    neo:jejune_source_slug "four-noble-truths"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 1 ;
    neo:text "The four truths are"^^xsd:string .

ex:node_4_f97800eb_b8fe_4903_9ebf_91dbcf4cafd2_14 a neo:Document ;
    neo:MENTIONS ex:node_4_f97800eb_b8fe_4903_9ebf_91dbcf4cafd2_10,
